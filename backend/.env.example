# Leave OPENAI_API_KEY empty to use the deterministic offline mock parser.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Azure OpenAI, vLLM, Ollama /v1, OpenRouter, xAI ...). Empty = api.openai.com
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1          # check what your key can use: GET /v1/models; gpt-5/o-series auto-omit temperature
# Optional price override for cost estimates (USD per 1M tokens) when LLM_MODEL is not in app/usage.py
LLM_PRICE_IN=
LLM_PRICE_OUT=
LLM_MAX_REPAIRS=1
LLM_FALLBACK_TO_MOCK=true
CHUNK_MAX_CHARS=24000
# SQLite by default; for Postgres: postgresql+psycopg://user:pass@localhost:5432/sopchk
DATABASE_URL=
EMBEDDING_MODEL=text-embedding-3-small   # used for semantic safety matching when OPENAI_API_KEY is set
# Auth: CHANGE JWT_SECRET in any shared environment; set COOKIE_SECURE=true behind HTTPS
JWT_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=false
DEMO_SEED=true            # seed demo companies/users on an empty DB
OCR_TIMEOUT_S=180

# ---- Legal (single place to swap; substituted into legal/terms.md + privacy.md) ----
OWNER_LEGAL_NAME=SOPCheck   # operator name shown in Terms/Privacy
TERMS_VERSION=2026-10-12-draft      # bump after editing legal/*.md -> every user must re-accept

# ---- Billing: Gumroad memberships (support/refunds via Gumroad only) ----
BILLING_ENFORCED=true
TRIAL_DAYS=14
TRIAL_MAX_TECHNICIANS=10
TRIAL_MAX_PARSES=50
PLAN_STARTER_PRODUCT_ID=            # Gumroad product_id (from the product's license-key settings)
PLAN_STARTER_CHECKOUT_URL=          # your Gumroad product link
PLAN_STARTER_PRICE=49
PLAN_STARTER_MAX_TECHNICIANS=10
PLAN_STARTER_MAX_PARSES=50
PLAN_TEAM_PRODUCT_ID=
PLAN_TEAM_CHECKOUT_URL=
PLAN_TEAM_PRICE=99
PLAN_TEAM_MAX_TECHNICIANS=50
PLAN_TEAM_MAX_PARSES=200
GUMROAD_VERIFY_URL=https://api.gumroad.com/v2/licenses/verify
LICENSE_RECHECK_DAYS=7

# ---- account / data deletion ----
DELETION_GRACE_DAYS=7        # workspace deletion: locked, cancellable, then hard-deleted (incl. photos)
PURGE_INTERVAL_S=3600        # background purge interval; or run `python -m app.cli purge-deleted` from cron

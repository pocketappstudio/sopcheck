{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/sopcheck/1.0.0/checklist.schema.json",
  "title": "Universal Technician Checklist (core)",
  "type": "object",
  "additionalProperties": false,
  "required": ["industry", "document_summary", "tasks"],
  "properties": {
    "industry": { "type": "string", "minLength": 1 },
    "document_summary": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_title", "description", "assigned_position", "site_requirement", "timeframe", "verification_method"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^T-[0-9]{3,}$" },
          "task_title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1 },
          "assigned_position": { "type": "string", "minLength": 1 },
          "site_requirement": { "type": "string", "minLength": 1 },
          "timeframe": { "type": "string", "minLength": 1 },
          "verification_method": {
            "type": "string",
            "enum": ["Checkbox", "Photo Upload", "Numeric Input", "Text Input", "Signature", "Dual Sign-off"]
          }
        }
      }
    }
  }
}
